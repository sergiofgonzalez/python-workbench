# Cognee quickstart — routed through Azure OpenAI

LLM_PROVIDER=azure
LLM_MODEL=azure/gpt-5-mini  # azure/{model-name} format for Azure OpenAI models
LLM_ENDPOINT="AzureOpenAI endpoint URL, e.g. https://your-resource-name.openai.azure.com/"
LLM_API_KEY="Your Azure OpenAI API key"
LLM_API_VERSION=2025-04-01-preview

EMBEDDING_PROVIDER=azure
EMBEDDING_MODEL=azure/text-embedding-3-large  # azure/{model-name} format for Azure OpenAI models
EMBEDDING_ENDPOINT="AzureOpenAI endpoint URL, e.g. https://your-resource-name.openai.azure.com/"
EMBEDDING_API_KEY="Your Azure OpenAI API key"
EMBEDDING_API_VERSION=2025-04-01-preview
EMBEDDING_DIMENSIONS=3072
