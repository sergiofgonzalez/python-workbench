# Actual HTTP dispatch is driven by the "openai/" prefix in EMBEDDING_MODEL,
# which makes litellm.aembedding hit api_base on the proxy.
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=openai/cohere.embed-multilingual-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENDPOINT="your-litellm-proxy-endpoint"
EMBEDDING_API_KEY="your-litellm-api-key"